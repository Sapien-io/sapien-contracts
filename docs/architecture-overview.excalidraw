    {
      "id": "roleDesc",
      "type": "text",
      "x": 50,
      "y": 520,
      "width": 900,
      "height": 120,
      "text": "Originator: Creates projects, funds reward pools, defines quality criteria. Must stake SAPIEN tokens.\nContributor: Performs tasks (e.g., data labeling), submits work for validation. Must stake SAPIEN tokens.\nValidator: Reviews contributions independently, reaches consensus on quality scores. Must stake SAPIEN tokens.\nOracle Adapter: Technical interface connecting external tools (CVAT, AI pipelines) to the protocol.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "groupIds": [],
      "roundness": null,
      "seed": 30,
      "version": 2,
      "versionNonce": 1147339838,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769016101004,
      "link": null,
      "locked": false,
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "frameId": null,
      "containerId": null,
      "originalText": "Originator: Creates projects, funds reward pools, defines quality criteria. Must stake SAPIEN tokens.\nContributor: Performs tasks (e.g., data labeling), submits work for validation. Must stake SAPIEN tokens.\nValidator: Reviews contributions independently, reaches consensus on quality scores. Must stake SAPIEN tokens.\nOracle Adapter: Technical interface connecting external tools (CVAT, AI pipelines) to the protocol.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "aT"
    },
