      "versionNonce": 20040618,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760000000017,
      "link": null,
      "locked": false,
      "text": "2) Controller signs delegated EIP-712 action\nSupports EOA signatures and ERC-1271 contract signatures",
      "fontSize": 24,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2) Controller signs delegated EIP-712 action\nSupports EOA signatures and ERC-1271 contract signatures",
      "autoResize": true,
      "lineHeight": 1.25
    },
