      "versionNonce": 269114746,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760000000007,
      "link": null,
      "locked": false,
      "text": "1) Participant identity is wallet address (EOA)\nProtocol state and permissions are keyed by msg.sender",
      "fontSize": 24,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) Participant identity is wallet address (EOA)\nProtocol state and permissions are keyed by msg.sender",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "l2-box",
      "type": "rectangle",
      "x": -930,
      "y": -145,
      "width": 760,
      "height": 130,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 85063871,
      "version": 1,
      "versionNonce": 714234921,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760000000008,
      "link": null,
      "locked": false
    },
    {
      "id": "l2-text",
      "type": "text",
      "x": -900,
      "y": -115,
      "width": 587,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 42312437,
      "version": 1,
      "versionNonce": 132865812,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760000000009,
      "link": null,
      "locked": false,
      "text": "2) Wallet signs and sends protocol tx directly\nNo forwarder or account indirection layer",
      "fontSize": 24,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2) Wallet signs and sends protocol tx directly\nNo forwarder or account indirection layer",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "l3-box",
      "type": "rectangle",
      "x": -930,
      "y": 35,
      "width": 760,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 610713012,
      "version": 1,
      "versionNonce": 54488102,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760000000010,
      "link": null,
      "locked": false
    },
    {
      "id": "l3-text",
      "type": "text",
      "x": -900,
      "y": 65,
      "width": 714,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
