    {
      "id": "r1-text",
      "type": "text",
      "x": 260,
      "y": -285,
      "width": 718,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
