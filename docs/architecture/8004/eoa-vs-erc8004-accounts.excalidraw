      "locked": false,
      "text": "4) AgentIdentityResolver resolves registry mode and ownership\nagentKey maps to deterministic AgentAccount execution endpoint",
      "fontSize": 24,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4) AgentIdentityResolver resolves registry mode and ownership\nagentKey maps to deterministic AgentAccount execution endpoint",
      "autoResize": true,
      "lineHeight": 1.25
    },
