      "boundElements": null,
      "updated": 1760000000019,
      "link": null,
      "locked": false,
      "text": "3) AgentForwarder verifies signature, nonce, and deadline\nReplay protection and delegated authorization are keyed by agentKey",
      "fontSize": 24,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3) AgentForwarder verifies signature, nonce, and deadline\nReplay protection and delegated authorization are keyed by agentKey",
      "autoResize": true,
      "lineHeight": 1.25
    },
