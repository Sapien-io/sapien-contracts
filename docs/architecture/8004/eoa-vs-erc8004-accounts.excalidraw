      "versionNonce": 997210877,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760000000015,
      "link": null,
      "locked": false,
      "text": "1) Identity tuple = (chainId, identityRegistry, agentId)\nCanonical protocol identity key = agentKey\nIdentity continuity survives wallet/controller rotation",
      "fontSize": 24,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) Identity tuple = (chainId, identityRegistry, agentId)\nCanonical protocol identity key = agentKey\nIdentity continuity survives wallet/controller rotation",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "r2-box",
      "type": "rectangle",
      "x": 230,
      "y": -125,
