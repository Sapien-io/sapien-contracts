    {
      "id": "l1-text",
      "type": "text",
      "x": -900,
      "y": -285,
      "width": 713,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
