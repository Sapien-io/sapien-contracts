        "type": 3
      },
      "seed": 9377792,
      "version": 1,
      "versionNonce": 83956124,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760000000012,
      "link": null,
      "locked": false
    },
    {
      "id": "l4-text",
      "type": "text",
      "x": -900,
      "y": 265,
      "width": 705,
      "height": 210,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 182660741,
      "version": 1,
      "versionNonce": 542834175,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760000000013,
      "link": null,
      "locked": false,
      "text": "Tradeoffs\n+ Lower implementation complexity and lower gas in hot paths\n+ Faster near-term shipping and simpler operations\n- Not strict ERC-8004 identity compatible\n- Wallet rotation can require rebinding or state migration\n- Contract-signer support can be fragmented",
      "fontSize": 22,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Tradeoffs\n+ Lower implementation complexity and lower gas in hot paths\n+ Faster near-term shipping and simpler operations\n- Not strict ERC-8004 identity compatible\n- Wallet rotation can require rebinding or state migration\n- Contract-signer support can be fragmented",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "r1-box",
      "type": "rectangle",
      "x": 230,
      "y": -315,
