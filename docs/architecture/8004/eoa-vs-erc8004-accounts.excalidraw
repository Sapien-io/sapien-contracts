      "roundness": null,
      "seed": 907861211,
      "version": 1,
      "versionNonce": 20576318,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1760000000011,
      "link": null,
      "locked": false,
      "text": "3) Core protocol executes and stores lifecycle state by address\nClaims, rewards, reputation, trust, and limits all map to wallet identity",
      "fontSize": 24,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3) Core protocol executes and stores lifecycle state by address\nClaims, rewards, reputation, trust, and limits all map to wallet identity",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "l4-box",
      "type": "rectangle",
      "x": -930,
      "y": 235,
      "width": 760,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff5f5",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
