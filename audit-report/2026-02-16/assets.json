{
  "description": "Asset tracking and custody analysis for Sapien PoQ v0.5 protocol",
  "assets": {
    "erc20_reward_tokens": {
      "description": "ERC20 tokens used as project rewards",
      "tracked_in": ["projectEscrow", "pendingRewards"],
      "custody_locations": [
        {
          "location": "projectEscrow[projectId][token]",
          "description": "Per-project escrow holding reward tokens",
          "controller": "QualityEngine contract",
          "access_pattern": "internal accounting, released via releaseContributorReward or refundEscrow"
        },
        {
          "location": "pendingRewards[user][token]",
          "description": "User-claimed but not yet withdrawn rewards",
          "controller": "QualityEngine contract",
          "access_pattern": "accumulated via reward releases, claimed via claimReward"
        }
      ],
      "flows": {
        "inbound": [
          "fundProject: originator → projectEscrow via adapter.transferFrom"
        ],
        "outbound": [
          "claimReward: pendingRewards → user wallet via token.transfer",
          "refundEscrow: projectEscrow → originator via token.transfer"
        ],
        "internal": [
          "releaseContributorReward: projectEscrow → pendingRewards",
          "dispute settlement: projectEscrow redistribution",
          "adapter fees: projectEscrow → treasury via adapter logic"
        ]
      },
      "accounting_variables": [
        "Project.totalRewards (fixed at funding)",
        "Project.totalQuantity (fixed at funding)",
        "Contribution.rewardRate (computed as totalRewards/totalQuantity)"
      ]
    },
    "sapien_stake_tokens": {
      "description": "SAPIEN ERC20 tokens held in ERC4626 vault",
      "tracked_in": ["StakeVault.accounts", "ERC4626 shares"],
      "custody_locations": [
        {
          "location": "StakeVault contract (ERC4626)",
          "description": "Main custody of all staked SAPIEN tokens",
          "controller": "StakeVault contract",
          "access_pattern": "users deposit/withdraw, protocol locks/unlocks via ENGINE_ROLE"
        }
      ],
      "accounting_variables": [
        "StakeAccount.contributorLock (locked for contribution claims)",
        "StakeAccount.validatorCapacity (available for validation commitments)",
        "StakeAccount.inFlight (committed to active validations)",
        "ERC4626 balanceOf(user) (total staked shares)",
        "availableBalance = totalAssets - (contributorLock + validatorCapacity + inFlight)"
      ],
      "state_transitions": {
        "deposit_flow": "user wallet → StakeVault (mint shares)",
        "contribution_lock": "available → contributorLock",
        "validation_lock": "available → validatorCapacity",
        "commit_stake": "validatorCapacity → inFlight",
        "successful_validation": "inFlight → validatorCapacity",
        "failed_validation": "inFlight → burned (slash)",
        "successful_contribution": "contributorLock → available",
        "failed_contribution": "contributorLock → burned (slash) or partial slash+unlock",
        "withdrawal": "available shares → user wallet (redeem)"
      }
    }
  },
  "custody_analysis": {
    "centralized_custody": {
      "description": "Single contract holding user assets",
      "contracts": ["QualityEngine (reward tokens)", "StakeVault (SAPIEN tokens)"],
      "risk_level": "high",
      "mitigations": [
        "nonReentrant guards on all economic functions",
        "comprehensive access controls",
        "emergency pause mechanism",
        "upgradeable but controlled upgrade process"
      ]
    },
    "custody_transfers": {
      "user_initiated": [
        "fundProject (reward tokens to escrow)",
        "deposit to StakeVault (SAPIEN staking)",
        "withdraw from StakeVault (SAPIEN unstaking)",
        "claimReward (withdraw accumulated rewards)"
      ],
      "protocol_initiated": [
        "releaseContributorReward (escrow to pending)",
        "refundEscrow (unused escrow to originator)",
        "dispute settlement (escrow redistribution)",
        "adapter fee collection (escrow to treasury)"
      ],
      "slashing_events": [
        "contributor slashing (burn SAPIEN shares)",
        "validator slashing (burn SAPIEN shares)",
        "dispute bond slashing (burn SAPIEN shares)",
        "originator stake slashing (burn SAPIEN shares)"
      ]
    }
  },
  "accounting_invariants": {
    "project_escrow_invariant": {
      "description": "Project escrow should equal funded amount minus distributed rewards",
      "formula": "projectEscrow[token] = initialFunding - ∑(releasedRewards + adapterFees)",
      "tracked_via": ["fundProject", "releaseContributorReward", "dispute settlements", "refundEscrow"]
    },
    "pending_rewards_invariant": {
      "description": "Pending rewards should reflect earned but unclaimed rewards",
      "formula": "pendingRewards[user][token] = ∑(earnedRewards) - ∑(claimedRewards)",
      "tracked_via": ["releaseContributorReward", "claimReward", "dispute settlements"]
    },
    "stake_accounting_invariant": {
      "description": "User's total stake should equal sum of all lock states plus available",
      "formula": "totalStaked = availableBalance + contributorLock + validatorCapacity + inFlight",
      "tracked_via": ["StakeVault operations", "ERC4626 balanceOf"]
    },
    "contribution_reward_invariant": {
      "description": "Total rewards distributed should not exceed project funding",
      "formula": "∑(contributionRewards + disputeRewards + adapterFees) ≤ project.totalRewards",
      "tracked_via": ["Contribution.rewardRate", "dispute settlements", "adapter fee collection"]
    }
  },
  "asset_risks": {
    "custody_risks": {
      "smart_contract_compromise": {
        "description": "If QualityEngine or StakeVault is compromised, all assets are at risk",
        "affected_assets": ["all reward tokens in escrow", "all staked SAPIEN tokens"],
        "mitigations": ["access controls", "upgrade mechanisms", "emergency pause", "comprehensive testing"]
      },
      "governance_compromise": {
        "description": "Admin/Operator roles could manipulate asset flows",
        "affected_assets": ["dispute resolutions", "escrow refunds", "fee parameters"],
        "mitigations": ["multi-sig requirements", "timelocks", "operator accountability"]
      },
      "adapter_compromise": {
        "description": "Malicious adapters could steal tokens during transferFrom",
        "affected_assets": ["reward tokens during funding"],
        "mitigations": ["adapter allowlist", "fee limits", "transfer verification"]
      }
    },
    "accounting_risks": {
      "overflow/underflow": {
        "description": "Mathematical operations on large token amounts",
        "affected_variables": ["totalRewards", "rewardRate", "stake amounts"],
        "mitigations": ["uint256 usage", "SafeMath patterns", "bounds checking"]
      },
      "precision_loss": {
        "description": "Integer division in reward calculations",
        "affected_variables": ["rewardRate = totalRewards / totalQuantity"],
        "mitigations": ["accept precision loss", "minimum reward floors"]
      },
      "state_desync": {
        "description": "Storage state becoming inconsistent across operations",
        "affected_variables": ["escrow balances", "stake accounting", "rewards tracking"],
        "mitigations": ["atomic operations", "invariant checks", "reentrancy guards"]
      }
    },
    "economic_risks": {
      "insufficient_funds": {
        "description": "Operations attempting to transfer more than available balance",
        "affected_operations": ["claimReward", "refundEscrow", "withdraw from vault"],
        "mitigations": ["balance checks", "graceful failures", "partial fulfillment"]
      },
      "fee_exploitation": {
        "description": "High fee settings could drain project funds",
        "affected_assets": ["project escrow"],
        "mitigations": ["fee limits (MAX_ADAPTER_FEE_BPS)", "admin controls", "transparency"]
      }
    }
  },
  "asset_flow_diagram": {
    "user_assets": {
      "sapien_tokens": "user wallet ↔ StakeVault (ERC4626) ↔ locked states",
      "reward_tokens": "user wallet → projectEscrow → pendingRewards → user wallet"
    },
    "protocol_assets": {
      "escrow": "project funding → contributor rewards + adapter fees + treasury + refunds",
      "stake": "user deposits → contributor locks + validator capacity + in-flight + slashing"
    }
  },
  "monitoring_requirements": {
    "key_metrics": [
      "total value locked (TVL) across all assets",
      "project escrow balances vs. expected distributions",
      "stake accounting consistency (available + locked = total)",
      "pending rewards vs. claimed rewards",
      "protocol fee accumulation",
      "slashing event frequency and amounts"
    ],
    "alert_conditions": [
      "escrow balance anomalies",
      "unexpected stake state transitions",
      "failed token transfers",
      "accounting invariant violations",
      "high slashing volumes"
    ]
  }
}