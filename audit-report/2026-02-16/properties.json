{
  "description": "Machine-readable properties for Sapien PoQ v0.5 formal verification",
  "properties": {
    "global_invariants": [
      {
        "id": "asset_conservation_erc20",
        "description": "ERC20 reward tokens are conserved across all accounting states",
        "property": "forall projectId, token :: projectEscrow[projectId][token] + sum(pendingRewards[user][token]) + sum(claimedRewards[user][token]) + adapterFees[token] + treasuryFees[token] == initialFunding[projectId][token]",
        "severity": "critical",
        "verification_tools": ["certora", "isabelle"],
        "counterexamples": ["fee_on_transfer_tokens", "rebasing_tokens"]
      },
      {
        "id": "stake_accounting_conservation",
        "description": "User stake is conserved across all accounting states",
        "property": "forall user :: vault.balanceOf(user) == availableBalance[user] + contributorLock[user] + validatorCapacity[user] + inFlight[user]",
        "severity": "critical",
        "verification_tools": ["certora", "echidna"],
        "counterexamples": ["rounding_errors", "overflow_underflow"]
      },
      {
        "id": "escrow_integrity",
        "description": "Project escrow covers all distributed rewards",
        "property": "forall projectId, token :: projectEscrow[projectId][token] >= sum(releasedRewards[projectId][index] + validatorRewards[projectId][index] + disputeRedistributions[projectId][index])",
        "severity": "critical",
        "verification_tools": ["certora", "isabelle"],
        "counterexamples": ["double_spending", "arithmetic_errors"]
      },
      {
        "id": "reputation_bounds",
        "description": "Reputation scores stay within defined bounds",
        "property": "forall user :: MIN_REPUTATION <= user.reputation <= MAX_REPUTATION",
        "severity": "high",
        "verification_tools": ["certora", "echidna"],
        "counterexamples": ["overflow", "underflow"]
      }
    ],
    "function_properties": {
      "createProject": [
        {
          "id": "create_project_state_transition",
          "description": "Project starts in CREATED state",
          "property": "post: projects[projectId].state == CREATED",
          "severity": "medium",
          "verification_tools": ["certora"],
          "preconditions": ["projectId not exists"]
        },
        {
          "id": "create_project_no_asset_changes",
          "description": "Project creation doesn't affect assets",
          "property": "post: totalSupply == pre_totalSupply && balances unchanged",
          "severity": "low",
          "verification_tools": ["certora"],
          "preconditions": ["valid config"]
        }
      ],
      "fundProject": [
        {
          "id": "fund_project_escrow_credit",
          "description": "Tokens are credited to project escrow",
          "property": "post: projectEscrow[projectId][token] == pre_projectEscrow + amount",
          "severity": "critical",
          "verification_tools": ["certora"],
          "preconditions": ["sufficient allowance", "valid adapter"]
        },
        {
          "id": "fund_project_fee_deduction",
          "description": "Origination fee is properly deducted",
          "property": "post: transferredAmount == amount - (amount * originationFeeBps / 10000)",
          "severity": "high",
          "verification_tools": ["certora"],
          "preconditions": ["originationFeeBps <= MAX_ADAPTER_FEE_BPS"]
        },
        {
          "id": "fund_project_no_double_funding",
          "description": "Cannot fund already funded project",
          "property": "pre: projects[projectId].state == CREATED ==> post: projects[projectId].state == FUNDED",
          "severity": "medium",
          "verification_tools": ["certora"],
          "counterexamples": ["reentrancy"]
        }
      ],
      "claimToContribute": [
        {
          "id": "claim_exclusive_index_assignment",
          "description": "Claimed indices are exclusively assigned",
          "property": "forall i in indices :: post: indexClaims[i] == msg.sender && pre: indexClaims[i] == address(0)",
          "severity": "critical",
          "verification_tools": ["certora", "echidna"],
          "counterexamples": ["race_conditions", "duplicate_indices"]
        },
        {
          "id": "claim_stake_locking",
          "description": "Stake is properly locked for claimed indices",
          "property": "post: contributorLock[msg.sender] >= pre_contributorLock + (quantity * minStakeToClaim)",
          "severity": "critical",
          "verification_tools": ["certora"],
          "preconditions": ["sufficient available balance"]
        },
        {
          "id": "claim_index_bounds",
          "description": "Claimed indices are within project bounds",
          "property": "forall i in indices :: 0 <= i < projects[projectId].quantity",
          "severity": "high",
          "verification_tools": ["certora"],
          "counterexamples": ["out_of_bounds_access"]
        }
      ],
      "contribute": [
        {
          "id": "contribute_ownership_check",
          "description": "Only claim owner can contribute",
          "property": "pre: indexClaims[index] == msg.sender",
          "severity": "high",
          "verification_tools": ["certora"],
          "counterexamples": ["unauthorized_contribution"]
        },
        {
          "id": "contribute_deadline_check",
          "description": "Contributions must be within deadline",
          "property": "block.timestamp <= claims[claimId].deadline",
          "severity": "medium",
          "verification_tools": ["certora"],
          "counterexamples": ["expired_contribution"]
        },
        {
          "id": "contribute_state_transition",
          "description": "Index state transitions to SUBMITTED",
          "property": "post: indexStates[projectId][index].state == SUBMITTED",
          "severity": "medium",
          "verification_tools": ["certora"],
          "preconditions": ["valid submissionHash"]
        }
      ],
      "commitValidation": [
        {
          "id": "commit_stake_movement",
          "description": "Stake moves from capacity to in-flight",
          "property": "post: validatorCapacity[msg.sender] == pre_validatorCapacity - stakeAmount && inFlight[msg.sender] == pre_inFlight + stakeAmount",
          "severity": "critical",
          "verification_tools": ["certora"],
          "preconditions": ["sufficient capacity", "valid reputation"]
        },
        {
          "id": "commit_hash_storage",
          "description": "Commit hash is properly stored",
          "property": "post: validationCommits[projectId][index][msg.sender].commitHash == commitHash",
          "severity": "high",
          "verification_tools": ["certora"],
          "counterexamples": ["hash_collision"]
        },
        {
          "id": "commit_no_duplicate",
          "description": "Cannot commit twice for same validation",
          "property": "pre: !validationCommits[projectId][index][msg.sender].exists ==> post: validationCommits[projectId][index][msg.sender].exists",
          "severity": "medium",
          "verification_tools": ["certora"],
          "counterexamples": ["replay_attack"]
        }
      ],
      "revealValidation": [
        {
          "id": "reveal_commit_verification",
          "description": "Reveal matches committed hash",
          "property": "keccak256(abi.encodePacked(score, salt)) == validationCommits[projectId][index][msg.sender].commitHash",
          "severity": "critical",
          "verification_tools": ["certora"],
          "counterexamples": ["wrong_reveal"]
        },
        {
          "id": "reveal_window_check",
          "description": "Reveal is within proper window",
          "property": "block.timestamp <= validationCommits[projectId][index][msg.sender].commitTime + REVEAL_WINDOW",
          "severity": "high",
          "verification_tools": ["certora"],
          "counterexamples": ["late_reveal"]
        },
        {
          "id": "reveal_score_bounds",
          "description": "Revealed score is within valid bounds",
          "property": "MIN_SCORE <= score <= MAX_SCORE",
          "severity": "medium",
          "verification_tools": ["certora"],
          "counterexamples": ["invalid_score"]
        }
      ],
      "computeConsensus": [
        {
          "id": "consensus_sufficient_participation",
          "description": "Consensus requires minimum validators",
          "property": "count(revealedValidations[projectId][index]) >= MIN_VALIDATORS",
          "severity": "critical",
          "verification_tools": ["certora", "echidna"],
          "counterexamples": ["insufficient_participation"]
        },
        {
          "id": "consensus_algorithm_call",
          "description": "Consensus algorithm is called with correct inputs",
          "property": "consensusAlgorithm.calculate(revealedValidations[projectId][index]) called with non-empty array",
          "severity": "high",
          "verification_tools": ["certora"],
          "preconditions": ["valid consensus algorithm"]
        },
        {
          "id": "consensus_state_transition",
          "description": "Index state transitions to CONSENSUS_COMPUTED",
          "property": "post: indexStates[projectId][index].state == CONSENSUS_COMPUTED",
          "severity": "medium",
          "verification_tools": ["certora"],
          "preconditions": ["all reveals collected"]
        }
      ],
      "settleValidator": [
        {
          "id": "settle_outlier_slashing",
          "description": "Outlier validators are slashed",
          "property": "if consensusResult.isOutlier[msg.sender] then vault.slashValidator called with correct amount",
          "severity": "critical",
          "verification_tools": ["certora"],
          "preconditions": ["consensus computed"]
        },
        {
          "id": "settle_reward_distribution",
          "description": "Accurate validators receive rewards",
          "property": "if !consensusResult.isOutlier[msg.sender] then pendingRewards[msg.sender] increased by reward amount",
          "severity": "high",
          "verification_tools": ["certora"],
          "preconditions": ["consensus computed"]
        },
        {
          "id": "settle_fee_deduction",
          "description": "Validation fee is deducted from rewards",
          "property": "validatorReward = baseReward * (1 - validationFeeBps / 10000)",
          "severity": "medium",
          "verification_tools": ["certora"],
          "preconditions": ["validationFeeBps <= MAX_ADAPTER_FEE_BPS"]
        }
      ],
      "releaseContributorReward": [
        {
          "id": "release_challenge_period",
          "description": "Cannot release during challenge period",
          "property": "block.timestamp > consensusComputedTime[projectId][index] + CHALLENGE_PERIOD",
          "severity": "critical",
          "verification_tools": ["certora"],
          "counterexamples": ["premature_release"]
        },
        {
          "id": "release_escrow_debit",
          "description": "Reward is debited from escrow",
          "property": "post: projectEscrow[projectId][token] == pre_projectEscrow - rewardAmount",
          "severity": "critical",
          "verification_tools": ["certora"],
          "preconditions": ["consensus accepted", "sufficient escrow"]
        },
        {
          "id": "release_pending_credit",
          "description": "Reward is credited to pending rewards",
          "property": "post: pendingRewards[contributor][token] == pre_pendingRewards + rewardAmount",
          "severity": "high",
          "verification_tools": ["certora"],
          "preconditions": ["accepted contribution"]
        }
      ],
      "claimReward": [
        {
          "id": "claim_balance_check",
          "description": "Cannot claim more than available balance",
          "property": "pre: pendingRewards[msg.sender][token] >= amount",
          "severity": "critical",
          "verification_tools": ["certora"],
          "counterexamples": ["insufficient_balance"]
        },
        {
          "id": "claim_transfer_success",
          "description": "Token transfer must succeed",
          "property": "token.transfer(msg.sender, amount) returns true",
          "severity": "critical",
          "verification_tools": ["certora"],
          "preconditions": ["valid token contract"]
        },
        {
          "id": "claim_balance_update",
          "description": "Pending balance is properly reduced",
          "property": "post: pendingRewards[msg.sender][token] == pre_pendingRewards - amount",
          "severity": "high",
          "verification_tools": ["certora"],
          "counterexamples": ["reentrancy"]
        }
      ],
      "openDispute": [
        {
          "id": "dispute_bond_locking",
          "description": "Dispute bond is properly locked",
          "property": "post: contributorLock[msg.sender] >= pre_contributorLock + bondAmount",
          "severity": "high",
          "verification_tools": ["certora"],
          "preconditions": ["sufficient stake", "within challenge window"]
        },
        {
          "id": "dispute_window_extension",
          "description": "Dispute extends challenge period",
          "property": "post: challengeDeadline[projectId][index] == max(pre_challengeDeadline, block.timestamp + DISPUTE_EXTENSION)",
          "severity": "medium",
          "verification_tools": ["certora"],
          "preconditions": ["valid evidence hash"]
        }
      ],
      "resolveDispute": [
        {
          "id": "resolve_operator_only",
          "description": "Only operator can resolve disputes",
          "property": "msg.sender.hasRole(OPERATOR_ROLE)",
          "severity": "high",
          "verification_tools": ["certora"],
          "counterexamples": ["unauthorized_resolution"]
        },
        {
          "id": "resolve_bond_settlement",
          "description": "Dispute bond is settled correctly",
          "property": "if upheld then challenger bond burned else challenger bond unlocked",
          "severity": "high",
          "verification_tools": ["certora"],
          "preconditions": ["active dispute"]
        },
        {
          "id": "resolve_escrow_redistribution",
          "description": "Escrow is redistributed based on resolution",
          "property": "if upheld then escrow redistributed according to consensusResult",
          "severity": "critical",
          "verification_tools": ["certora"],
          "preconditions": ["sufficient escrow"]
        }
      ],
      "expireClaim": [
        {
          "id": "expire_deadline_check",
          "description": "Only expired claims can be expired",
          "property": "block.timestamp > claims[claimId].deadline",
          "severity": "medium",
          "verification_tools": ["certora"],
          "counterexamples": ["premature_expiry"]
        },
        {
          "id": "expire_stake_penalty",
          "description": "Expired claims result in stake penalties",
          "property": "post: contributorLock[contributor] < pre_contributorLock[contributor]",
          "severity": "high",
          "verification_tools": ["certora"],
          "preconditions": ["expired claim"]
        },
        {
          "id": "expire_index_reclamation",
          "description": "Expired indices are reclaimed",
          "property": "forall i in indices :: post: indexClaims[i] == address(0)",
          "severity": "medium",
          "verification_tools": ["certora"],
          "preconditions": ["expired claim"]
        }
      ]
    },
    "flow_properties": {
      "project_setup_flow": [
        {
          "id": "project_creation_state",
          "description": "Project starts in correct initial state",
          "property": "post: projects[projectId].state == CREATED",
          "severity": "low",
          "verification_tools": ["certora"],
          "flow_step": "createProject"
        },
        {
          "id": "project_funding_transition",
          "description": "Project transitions to FUNDED after funding",
          "property": "post: projects[projectId].state == FUNDED && projectEscrow[projectId] > 0",
          "severity": "medium",
          "verification_tools": ["certora"],
          "flow_step": "fundProject"
        },
        {
          "id": "project_activation_condition",
          "description": "Project becomes ACTIVE when first claim is made",
          "property": "if pre: projects[projectId].state == FUNDED then post: projects[projectId].state == ACTIVE",
          "severity": "medium",
          "verification_tools": ["certora"],
          "flow_step": "claimToContribute"
        }
      ],
      "contribution_flow": [
        {
          "id": "index_exclusive_assignment",
          "description": "Claimed indices are exclusively assigned",
          "property": "forall i in indices :: post: claims[i].owner == msg.sender && pre: claims[i].owner == address(0)",
          "severity": "critical",
          "verification_tools": ["certora", "echidna"],
          "flow_step": "claimToContribute"
        },
        {
          "id": "contribution_ownership",
          "description": "Only claim owner can submit contribution",
          "property": "pre: claims[index].owner == msg.sender",
          "severity": "high",
          "verification_tools": ["certora"],
          "flow_step": "contribute"
        },
        {
          "id": "contribution_state_transition",
          "description": "Index state transitions correctly through contribution flow",
          "property": "post: indexStates[projectId][index].state == SUBMITTED",
          "severity": "medium",
          "verification_tools": ["certora"],
          "flow_step": "contribute"
        }
      ],
      "validation_flow": [
        {
          "id": "commit_reveal_temporal_order",
          "description": "Reveal can only happen after commit",
          "property": "pre: validationCommits[projectId][index][msg.sender].exists",
          "severity": "critical",
          "verification_tools": ["certora"],
          "flow_step": "revealValidation"
        },
        {
          "id": "commit_hash_verification",
          "description": "Reveal matches committed hash",
          "property": "keccak256(abi.encodePacked(score, salt)) == validationCommits[projectId][index][msg.sender].commitHash",
          "severity": "critical",
          "verification_tools": ["certora"],
          "flow_step": "revealValidation"
        },
        {
          "id": "stake_capacity_to_commit",
          "description": "Validator capacity properly converted to commit stake",
          "property": "post: validatorCapacity[msg.sender] == pre_validatorCapacity - stakeAmount && inFlight[msg.sender] == pre_inFlight + stakeAmount",
          "severity": "critical",
          "verification_tools": ["certora"],
          "flow_step": "commitValidation"
        }
      ],
      "consensus_flow": [
        {
          "id": "consensus_minimum_reveals",
          "description": "Consensus requires minimum revealed validations",
          "property": "count(revealedValidations[projectId][index]) >= MIN_VALIDATORS",
          "severity": "critical",
          "verification_tools": ["certora", "echidna"],
          "flow_step": "computeConsensus"
        },
        {
          "id": "consensus_state_finalization",
          "description": "Consensus computation finalizes validation phase",
          "property": "post: indexStates[projectId][index].state == CONSENSUS_COMPUTED",
          "severity": "medium",
          "verification_tools": ["certora"],
          "flow_step": "computeConsensus"
        },
        {
          "id": "consensus_algorithm_correctness",
          "description": "Consensus algorithm called with correct parameters",
          "property": "consensusAlgorithm.calculate(revealedValidations[projectId][index]) called",
          "severity": "high",
          "verification_tools": ["certora"],
          "flow_step": "computeConsensus"
        }
      ],
      "settlement_flow": [
        {
          "id": "settlement_consensus_required",
          "description": "Settlement requires computed consensus",
          "property": "pre: indexStates[projectId][index].state == CONSENSUS_COMPUTED",
          "severity": "high",
          "verification_tools": ["certora"],
          "flow_step": "settleValidator"
        },
        {
          "id": "validator_reward_distribution",
          "description": "Validator rewards distributed based on consensus outcome",
          "property": "if !isOutlier then pendingRewards[msg.sender] increased by calculated amount",
          "severity": "high",
          "verification_tools": ["certora"],
          "flow_step": "settleValidator"
        },
        {
          "id": "reward_release_challenge_wait",
          "description": "Contributor rewards cannot be released during challenge period",
          "property": "block.timestamp > consensusComputedTime[projectId][index] + CHALLENGE_PERIOD",
          "severity": "critical",
          "verification_tools": ["certora"],
          "flow_step": "releaseContributorReward"
        }
      ],
      "dispute_flow": [
        {
          "id": "dispute_challenge_window",
          "description": "Disputes can only be opened during challenge period",
          "property": "block.timestamp <= consensusComputedTime[projectId][index] + CHALLENGE_PERIOD",
          "severity": "high",
          "verification_tools": ["certora"],
          "flow_step": "openDispute"
        },
        {
          "id": "dispute_bond_locking",
          "description": "Dispute requires bond locking",
          "property": "post: contributorLock[msg.sender] >= pre_contributorLock + bondAmount",
          "severity": "high",
          "verification_tools": ["certora"],
          "flow_step": "openDispute"
        },
        {
          "id": "dispute_resolution_operator_only",
          "description": "Only operators can resolve disputes",
          "property": "msg.sender.hasRole(OPERATOR_ROLE)",
          "severity": "high",
          "verification_tools": ["certora"],
          "flow_step": "resolveDispute"
        }
      ]
    },
    "temporal_properties": [
      {
        "id": "deadline_monotonicity",
        "description": "Deadlines never decrease",
        "property": "forall t1, t2 :: t1 < t2 ==> deadlines[t1] <= deadlines[t2]",
        "severity": "medium",
        "verification_tools": ["certora"],
        "counterexamples": ["time_manipulation"]
      },
      {
        "id": "window_sequencing",
        "description": "Validation windows are properly sequenced",
        "property": "forall validation :: commitTime + COMMIT_WINDOW <= revealTime + REVEAL_WINDOW",
        "severity": "high",
        "verification_tools": ["certora"],
        "counterexamples": ["overlapping_windows"]
      },
      {
        "id": "challenge_period_enforcement",
        "description": "Challenge periods are respected",
        "property": "forall consensus :: !canReleaseReward until block.timestamp > consensusTime + CHALLENGE_PERIOD",
        "severity": "critical",
        "verification_tools": ["certora"],
        "counterexamples": ["premature_settlement"]
      },
      {
        "id": "escalation_timeout_enforcement",
        "description": "Unresolved disputes can be escalated after timeout",
        "property": "forall dispute :: if block.timestamp > dispute.timestamp + OPERATOR_TIMEOUT then dispute.canEscalate",
        "severity": "high",
        "verification_tools": ["certora"],
        "counterexamples": ["censorship_prevention_failure"]
      },
      {
        "id": "report_resolution_windows",
        "description": "Originator reports have bounded resolution times",
        "property": "forall report :: block.timestamp <= report.timestamp + OPERATOR_TIMEOUT or report.canEscalate",
        "severity": "medium",
        "verification_tools": ["certora"],
        "counterexamples": ["indefinite_report_hanging"]
      }
    ],
    "economic_properties": [
      {
        "id": "slashing_conservation",
        "description": "Slashing only burns existing staked tokens",
        "property": "forall slash :: slashedAmount <= availableStake && totalSupply decreases by slashedAmount",
        "severity": "critical",
        "verification_tools": ["certora"],
        "counterexamples": ["token_creation", "double_slashing"]
      },
      {
        "id": "reward_bounds_enforcement",
        "description": "Distributed rewards stay within project limits",
        "property": "forall reward :: 0 <= reward.amount <= project.maxRewardPerContribution",
        "severity": "high",
        "verification_tools": ["certora"],
        "counterexamples": ["reward_inflation"]
      },
      {
        "id": "fee_percentage_limits",
        "description": "Adapter and protocol fees stay within bounds",
        "property": "forall fee :: fee.amount <= project.totalRewards * MAX_FEE_PERCENTAGE",
        "severity": "high",
        "verification_tools": ["certora"],
        "counterexamples": ["excessive_fee_extraction"]
      },
      {
        "id": "bond_sufficiency",
        "description": "Dispute and report bonds meet minimum requirements",
        "property": "forall bond :: bond.amount >= MIN_DISPUTE_BOND || bond.amount >= MIN_REPORT_BOND",
        "severity": "medium",
        "verification_tools": ["certora"],
        "counterexamples": ["frivolous_disputes"]
      },
      {
        "id": "stake_sybil_prevention",
        "description": "Minimum stake requirements prevent Sybil attacks",
        "property": "forall participation :: user.totalStake >= minStakeRequirement",
        "severity": "high",
        "verification_tools": ["certora"],
        "counterexamples": ["stake_bypass"]
      }
    ],
    "consensus_properties": [
      {
        "id": "weighted_average_correctness",
        "description": "Consensus produces valid weighted average",
        "property": "consensusResult.score = sum(weight[i] * score[i]) / sum(weight[i])",
        "severity": "high",
        "verification_tools": ["certora", "isabelle"],
        "preconditions": ["valid weights", "non-zero total weight"]
      },
      {
        "id": "outlier_detection_bounds",
        "description": "Outlier detection uses statistical bounds",
        "property": "isOutlier[i] <=> |score[i] - weightedMean| > standardDeviation * THRESHOLD",
        "severity": "medium",
        "verification_tools": ["certora"],
        "preconditions": ["sufficient participants"]
      },
      {
        "id": "minimum_participation",
        "description": "Consensus requires minimum participation",
        "property": "participantCount >= MIN_VALIDATORS",
        "severity": "critical",
        "verification_tools": ["certora", "echidna"],
        "counterexamples": ["single_validator_control"]
      },
      {
        "id": "consensus_determinism",
        "description": "Consensus algorithm is deterministic",
        "property": "forall identicalInputs :: calculate(inputs1) == calculate(inputs2)",
        "severity": "high",
        "verification_tools": ["certora"],
        "counterexamples": ["non_deterministic_consensus"]
      },
      {
        "id": "consensus_isolation",
        "description": "Consensus algorithm cannot cause side effects",
        "property": "forall consensusCall :: !modifiesStorage && !makesExternalCalls",
        "severity": "critical",
        "verification_tools": ["certora"],
        "counterexamples": ["consensus_reentrancy"]
      }
    ],
    "access_control_properties": [
      {
        "id": "role_based_access",
        "description": "Admin functions require proper roles",
